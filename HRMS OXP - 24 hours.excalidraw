    {
      "id": "GgJGlrQx9V1Ti32GssCgg",
      "type": "text",
      "x": 2614.5552221456514,
      "y": 5940.479102808655,
      "width": 1341.5977783203125,
      "height": 2310,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
