    {
      "id": "A8jY-RMGTxXDe6VthY_d1",
      "type": "text",
      "x": 227.49999851249413,
      "y": 4173.735008117705,
      "width": 1021.3040161132812,
      "height": 245,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "bsf",
      "roundness": null,
      "seed": 1732994844,
      "version": 715,
      "versionNonce": 300106276,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788425670817,
      "link": null,
      "locked": false,
      "text": "Time Off:\n\n- Requests should support a simple approval flow.\n- For leave types that require allocation, approved leave should reduce the\nemployee’s available balance.\n- Time Off Types should define how each leave type behaves. The exact\npolicies and validations are open to interpretation.",
      "fontSize": 28,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": "fR5hxivvQlTYU06iGP2FY",
      "originalText": "Time Off:\n\n- Requests should support a simple approval flow.\n- For leave types that require allocation, approved leave should reduce the employee’s available balance.\n- Time Off Types should define how each leave type behaves. The exact policies and validations are open to interpretation.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
