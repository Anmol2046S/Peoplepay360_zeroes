    {
      "id": "iyCY-CFYgVBfZdvMZVKdm",
      "type": "rectangle",
      "x": 1351.5357127982093,
      "y": 1948.2766747843712,
      "width": 1400.000000000001,
      "height": 585,
      "angle": 0,
