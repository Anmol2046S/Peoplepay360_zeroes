generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// -----------------------------------------------------------------------------
// CORE & MULTI-TENANCY
// -----------------------------------------------------------------------------
model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users             User[]
  employees         Employee[]
  timeOffTypes      TimeOffType[]
  salaryStructures  SalaryStructure[]
  payruns           Payrun[]
  auditLogs         AuditLog[]
}

model User {
  id           String   @id @default(cuid())
  orgId        String
  email        String   @unique
  passwordHash String
  roleId       String
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organization Organization @relation(fields: [orgId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])
  employees    Employee[]   @relation("UserEmployees")
}

model Role {
  id          String   @id @default(cuid())
  name        String
  permissions String[] // e.g. ["EMPLOYEE_READ", "PAYRUN_CALCULATE"]
  createdAt   DateTime @default(now())

  users User[]
}

// -----------------------------------------------------------------------------
// HR CORE (Employee, Contract, Schedule)
// -----------------------------------------------------------------------------
model Employee {
  id        String   @id @default(cuid())
  orgId     String
  userId    String?
  firstName String
  lastName  String
  status    String   @default("ACTIVE") // ACTIVE, TERMINATED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization       Organization         @relation(fields: [orgId], references: [id])
  user               User?                @relation("UserEmployees", fields: [userId], references: [id])
  contracts          EmploymentContract[]
  attendance         Attendance[]
  timeOffAllocations TimeOffAllocation[]
  timeOffRequests    TimeOffRequest[]
  payrunEmployees    PayrunEmployee[]
  payslips           Payslip[]

  @@index([orgId])
}

model EmploymentContract {
  id               String    @id @default(cuid())
  employeeId       String
  salaryStructureId String
  startDate        DateTime
  endDate          DateTime?
  status           String    @default("ACTIVE") // ACTIVE, EXPIRED, TERMINATED
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employee        Employee         @relation(fields: [employeeId], references: [id])
  salaryStructure SalaryStructure  @relation(fields: [salaryStructureId], references: [id])
  workingSchedules WorkingSchedule[]

  @@index([employeeId])
}

model WorkingSchedule {
  id         String   @id @default(cuid())
  contractId String
  days       String[] // e.g., ["MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY", "FRIDAY"]
  hours      Decimal  // Standard daily hours

  contract EmploymentContract @relation(fields: [contractId], references: [id])
}

// -----------------------------------------------------------------------------
// ATTENDANCE & TIME-OFF
// -----------------------------------------------------------------------------
model Attendance {
  id          String    @id @default(cuid())
  employeeId  String
  date        DateTime  @db.Date
  checkIn     DateTime
  checkOut    DateTime?
  workedHours Decimal?
  status      String    @default("PRESENT") // PRESENT, ABSENT, HALF_DAY
  createdAt   DateTime  @default(now())

  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([employeeId, date])
}

model TimeOffType {
  id     String  @id @default(cuid())
  orgId  String
  name   String
  isPaid Boolean @default(true)

  organization       Organization        @relation(fields: [orgId], references: [id])
  allocations        TimeOffAllocation[]
  requests           TimeOffRequest[]
}

model TimeOffAllocation {
  id         String   @id @default(cuid())
  employeeId String
  typeId     String
  totalDays  Decimal
  usedDays   Decimal  @default(0)

  employee    Employee    @relation(fields: [employeeId], references: [id])
  timeOffType TimeOffType @relation(fields: [typeId], references: [id])

  @@unique([employeeId, typeId])
}

model TimeOffRequest {
  id         String   @id @default(cuid())
  employeeId String
  typeId     String
  startDate  DateTime @db.Date
  endDate    DateTime @db.Date
  status     String   @default("PENDING") // PENDING, APPROVED, REJECTED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  employee    Employee    @relation(fields: [employeeId], references: [id])
  timeOffType TimeOffType @relation(fields: [typeId], references: [id])
}

// -----------------------------------------------------------------------------
// PAYROLL ENGINE (Structures, Rules)
// -----------------------------------------------------------------------------
model SalaryStructure {
  id        String   @id @default(cuid())
  orgId     String
  name      String
  version   Int      @default(1)
  status    String   @default("ACTIVE")

  organization Organization         @relation(fields: [orgId], references: [id])
  contracts    EmploymentContract[]
  rules        SalaryRule[]
}

model SalaryRule {
  id              String   @id @default(cuid())
  structureId     String
  code            String
  name            String
  category        String   // BASIC, ALLOWANCE, DEDUCTION, GROSS, NET
  computationType String   // FIXED, PERCENTAGE, FORMULA
  sequence        Int
  value           Decimal? // Fixed amount, or percentage
  dependsOn       String[] // e.g. ["BASIC", "ALLOWANCE"] for formulas
  status          String   @default("ACTIVE")

  structure SalaryStructure @relation(fields: [structureId], references: [id])

  @@unique([structureId, code])
}

// -----------------------------------------------------------------------------
// PAYRUN & PAYSLIP
// -----------------------------------------------------------------------------
model Payrun {
  id          String   @id @default(cuid())
  orgId       String
  periodStart DateTime @db.Date
  periodEnd   DateTime @db.Date
  status      String   @default("DRAFT") // DRAFT, CALCULATING, VALIDATING, READY_FOR_APPROVAL, APPROVED, FINALIZED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  organization Organization     @relation(fields: [orgId], references: [id])
  employees    PayrunEmployee[]
  payslips     Payslip[]
}

model PayrunEmployee {
  id         String @id @default(cuid())
  payrunId   String
  employeeId String
  status     String @default("INCLUDED") // INCLUDED, EXCLUDED

  payrun   Payrun   @relation(fields: [payrunId], references: [id])
  employee Employee @relation(fields: [employeeId], references: [id])

  @@unique([payrunId, employeeId])
}

model Payslip {
  id          String   @id @default(cuid())
  payrunId    String
  employeeId  String
  grossAmount Decimal
  netAmount   Decimal
  status      String   @default("DRAFT") // DRAFT, FINALIZED
  createdAt   DateTime @default(now())

  payrun   Payrun        @relation(fields: [payrunId], references: [id])
  employee Employee      @relation(fields: [employeeId], references: [id])
  lines    PayslipLine[]

  @@unique([payrunId, employeeId])
}

model PayslipLine {
  id        String   @id @default(cuid())
  payslipId String
  ruleCode  String
  category  String
  amount    Decimal
  sequence  Int
  metadata  String?  // JSON string containing calc details for explainability

  payslip Payslip @relation(fields: [payslipId], references: [id])
}

// -----------------------------------------------------------------------------
// AUDIT
// -----------------------------------------------------------------------------
model AuditLog {
  id        String   @id @default(cuid())
  orgId     String
  actorId   String?  // userId
  action    String
  entity    String
  entityId  String
  timestamp DateTime @default(now())
  metadata  String?  // JSON string of before/after

  organization Organization @relation(fields: [orgId], references: [id])
}